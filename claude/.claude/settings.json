{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.astral.sh)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cd:*)",
      "Bash(pwd:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ag:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(gh:*)",
      "Bash(yarn:*)",
      "Bash(python:*)",
      "Bash(cargo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(tar:*)",
      "Bash(gzip:*)",
      "Bash(unzip:*)",
      "Bash(which:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(tree:*)",
      "Bash(bat:*)",
      "Bash(fzf:*)",
      "Bash(tmux:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(uv:*)",
      "Read(./.env.example)",
      "Write(./.env.example)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(passwd:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(poweroff:*)",
      "Bash(systemctl:reboot)",
      "Bash(systemctl:poweroff)",
      "Bash(systemctl:halt)",
      "Bash(rm:-rf /)",
      "Bash(rm:-rf /*)",
      "Bash(dd:if=/dev/zero of=/dev/*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(*.env.local)",
      "Read(*.env.production)",
      "Write(./**/.ssh/**)",
      "Bash(chmod:777:*)",
      "Bash(chown:root:*)"
    ],
    "ask": [],
    "defaultMode": "default"
  },
  "model": "opusplan",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "neoscribe@bazaar": true,
    "mermaid@bazaar": false,
    "sdlc@bazaar": false,
    "para-pkm@bazaar": true,
    "iwe-pkm@bazaar": false,
    "feature-dev@claude-plugins-official": false,
    "supabase@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "content@bazaar": true
  },
  "extraKnownMarketplaces": {
    "bazaar": {
      "source": {
        "source": "git",
        "url": "git@github.com:jed-richards/bazaar.git"
      }
    }
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "autoCompactWindow": 200000,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark-ansi",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
